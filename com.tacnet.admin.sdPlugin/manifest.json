{
  "SDKVersion": 2,
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    }
  ],
  "Author": "TacNet",
  "CodePath": "plugin.html",
  "Description": "Simulation admin, environmental injections, and EW controls for TacNet Server",
  "Name": "TacNet Admin",
  "Icon": "icon",
  "Version": "1.0.0",
  "Actions": [
    {
      "UUID": "com.tacnet.admin.jam",
      "Name": "EW Jamming Control",
      "Tooltip": "Toggle RF jamming or adjust intensity on a target channel",
      "Icon": "icon_jam",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "triggerDescription": {
          "rotate": "Adjust Intensity",
          "push": "Toggle Jamming",
          "touch": "Toggle Jamming"
        }
      },
      "States": [
        {
          "Image": "icon_jam"
        }
      ],
      "Settings": {
        "channel": 1,
        "server_port": 8890
      },
      "PropertyInspectorPath": "pi.html"
    },
    {
      "UUID": "com.tacnet.admin.weather",
      "Name": "Weather Control",
      "Tooltip": "Toggle weather or adjust severity of environmental propagation",
      "Icon": "icon_weather",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$A1",
        "triggerDescription": {
          "rotate": "Adjust Severity",
          "push": "Toggle Weather",
          "touch": "Toggle Weather"
        }
      },
      "States": [
        {
          "Image": "icon_weather"
        }
      ],
      "Settings": {
        "weather_action": "toggle",
        "server_port": 8890
      },
      "PropertyInspectorPath": "pi.html"
    },
